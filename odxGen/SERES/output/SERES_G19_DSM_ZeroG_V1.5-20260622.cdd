<ENUMDEF id='_000001FF625FF980' oid='5458E2CF079B477eA5D3D0F08FF883B8' temploid='C5E3730E21124c709D3A4FEA64299E23' attrcatref='_000001FF6256B450' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Transport Protocol Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Type of used Transport Protocol (e.g. ISO15765)</TUV>
</DESC>
<QUAL>CAN.TransportProtocolType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>ISO15765</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_000001FF625FF3B0' oid='F902CE95605C432aA0970F98C1DCC13E' temploid='3C6C51D750A940df883ECD15A81A424E' attrcatref='_000001FF6256B450' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Addressing Scheme</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Addressing Scheme used for physical requests and responses.</TUV>
</DESC>
<QUAL>CAN.AddrScheme</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Normal</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_000001FF625FFB70' oid='E4BB0068D8A94c82A2F5EFB22D3A2914' temploid='21854EDB6291471bA024632AD6A7688E' attrcatref='_000001FF6256B450' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>CAN-ID Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>CAN-ID Type used for physical requests and responses</TUV>
</DESC>
<QUAL>CAN.CanIdType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>11-Bit</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>29-Bit</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_000001FF61DE6DC0' oid='DB24A923AE0C495a81B6D1D75E0A99EF' temploid='4E50598D7EA34ad0907B94747FC31667' attrcatref='_000001FF6256B450' usage='sys' v='1792' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Request CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The request CAN identifier for physical requests. The hex value not only describes the identifier but also the priority of the message. The higher the number, the lower the priority.</TUV>
</DESC>
<QUAL>CAN.ReqCanId</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF61DE61C0' oid='EC16AEE402EB499bBC3FB776BB62B008' temploid='8F1A928D8071442b8A555654C2A03325' attrcatref='_000001FF6256B450' usage='sys' v='1536' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Response CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The response CAN identifier for physical responses.The response for functional requests is sent via the physical path.</TUV>
</DESC>
<QUAL>CAN.ResCanId</QUAL>
</UNSDEF>
<ENUMDEF id='_000001FF6260CB70' oid='0D8F9B4D742B40d180AC54CDA8D64C08' temploid='D61D6570A2364e2eB940FC451F1217B9' attrcatref='_000001FF6256B450' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Functional Addressing Scheme</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Addressing Scheme used for functional requests.</TUV>
</DESC>
<QUAL>CAN.AddrSchemeFunc</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Normal</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_000001FF6260CD60' oid='6344839BBEB04dba92D54C04C7B7A6D6' temploid='4DA67705CCAE4edd9A4EAADA46586003' attrcatref='_000001FF6256B450' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Functional CAN-ID Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>CAN-ID Type used for functional request</TUV>
</DESC>
<QUAL>CAN.CanIdTypeFunc</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>11-Bit</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>29-Bit</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_000001FF61DE53C0' oid='5A7D24902AFE4ebb93DE2B38E72B47A8' temploid='DD6D93D8D676436fA860209E9F5AE639' attrcatref='_000001FF6256B450' usage='sys' v='1872' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Functional Request CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The request CAN identifier for functional requests.</TUV>
</DESC>
<QUAL>CAN.ReqCanIdFunc</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF61DE51C0' oid='A42BFFA631B84033852D42512D732656' temploid='AAA2C8DCAD0F4d5b9FECEAF3BAFA5517' attrcatref='_000001FF6256B450' usage='sys' v='1920' df='hex'>
<NAME>
<TUV xml:lang='en-US'>UUDT Response CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>UUDT Response CAN-ID used for multiple responses and/or periodic responses.</TUV>
</DESC>
<QUAL>CAN.UudtResCanId</QUAL>
</UNSDEF>
<ENUMDEF id='_000001FF6260C3B0' oid='D5ECB8F5F1024b24A49B4505E3D0A029' temploid='55F798A69E4D496e82365EC2BB8057C2' attrcatref='_000001FF6256B450' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>UUDT CAN-ID Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Received CAN Format for CAN ID without segmentation (Segment Type Bit must = 0)</TUV>
</DESC>
<QUAL>CAN.UudtCanIdType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>11-Bit</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>29-Bit</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_000001FF61DE63C0' oid='888C9D2830674f659BDC02A14FA6D02D' temploid='236A22BB7ED34b99B96A150778D7B52A' attrcatref='_000001FF6256B510' usage='sys' v='150' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Timeout for the client to wait after the successful transmission of a request message for the start of incoming response messages. In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>CAN.P2Client</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF61DE69C0' oid='80D8A01C775E4da3B05F372A06F05F6B' temploid='17F5085A5AAD46bd8BD8A50BE2A50334' attrcatref='_000001FF6256B510' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Performance requirement for the server to start with the response message after the reception of a request message. In UDS this is the timeout for the default session.The tester will also require the P2Server timeout, since in UDS service "DiagnosticSessionControl"returns the P2Server and P2*Server timeouts – the tester has to calculate the offset manually and has to add it to the returned P2Server and P2*Server timeouts.</TUV>
</DESC>
<QUAL>CAN.P2Server</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF61DE57C0' oid='7264637957D746f6A9486031D8EB72EA' temploid='981A47637F6A49318C86FFC3CDC7B36E' attrcatref='_000001FF6256B510' usage='sys' v='2000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2*Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enhanced timeout for the client to wait after the reception of a negative response message with response code 78 hex for the start of incoming response messages. In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>CAN.P2ExClient</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF61DE59C0' oid='A1C966E88E1F4a56B168E4910178106A' temploid='9C4D6D08A311402e86A050A6D6E57408' attrcatref='_000001FF6256B510' usage='sys' v='1950' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2*Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Performance requirement for the server to start with the response message after the transmission of a negative response message with response code 78 hex (enhanced response timing). In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>CAN.P2ExServer</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62611410' oid='CCCA999BB1134b119A5249B80E8C35FD' temploid='66161D73836B4a5cB03605A5800B0C85' attrcatref='_000001FF6256B510' usage='sys' v='4000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>S3Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time between functionally addressed Tester Present request messages transmitted by the client to keep a diagnostic session other than the defaultSession active in multiple servers (functional communication) or maximum time between physically transmitted request messages to a single server (physical communication).</TUV>
</DESC>
<QUAL>CAN.S3Client</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF6260F810' oid='6EB82329A0AC421bB1F58C773B4DE023' temploid='8A277D4CB181480a989F32CFDAAE68AB' attrcatref='_000001FF6256B510' usage='sys' v='5000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>S3Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for the server to keep a diagnostic session other than the defaultSession active while not receiving any diagnostic request message</TUV>
</DESC>
<QUAL>CAN.S3Server</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF6260EE10' oid='C37644A79F4A483f85F78A605FD3C791' temploid='1A9C386131B14e029D02B00AE733E3A4' attrcatref='_000001FF6256B510' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P3ClientPhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Minimum time for the client to wait after the successful transmission of a physically addressed request message (indicated via N_USData.con) with no response required before it can transmit the next physically addressed request message.
Minimum value = P2Server</TUV>
</DESC>
<QUAL>CAN.P3ClientPhys</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62612810' oid='CC1ED272C1514a8bBC3657818F2783DE' temploid='22AABA5DEC33435585551D9B4D67065A' attrcatref='_000001FF6256B450' usage='sys' v='15872' df='hex'>
<NAME>
<TUV xml:lang='en-US'>TesterPresentPhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Defines the TesterPresent message for physically addressed requests used to keep a diagnostic session active.</TUV>
</DESC>
<QUAL>CAN.TesterPresentPhys</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF6260FC10' oid='69C118A91D3442a0AD1A8EF70F54BBAE' temploid='2573FACA63C94dcf9C065B5D01369B5D' attrcatref='_000001FF6256B510' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P3ClientFunc</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Minimum time for the client to wait after the successful transmission of a functionally addressed request message (indicated via N_USData.con) before it can transmit the next functionally addressed request message in case no response is required or the requested data is only supported by a subset of the functionally addressed servers.
Minimum value = P2Server.</TUV>
</DESC>
<QUAL>CAN.P3ClientFunc</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF6260F410' oid='E9B44EC8733E4ef0930DE6DFBCE39515' temploid='0A6B2FC1A4784590810B6D8F2395245F' attrcatref='_000001FF6256B450' usage='sys' v='16000' df='hex'>
<NAME>
<TUV xml:lang='en-US'>TesterPresentFunc</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Defines the TesterPresent message for functionally addressed requests used to keep a diagnostic session active.</TUV>
</DESC>
<QUAL>CAN.TesterPresentFunc</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62610E10' oid='E749C4D4CB284c299C8C3B412898825E' temploid='48C51BB08406428dB383652046E2F120' attrcatref='_000001FF6256B510' usage='sys' v='20' df='dec'>
<NAME>
<TUV xml:lang='en-US'>STmin</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>(Separation Time) defines the minimum time gap between consecutive frames.Values from 0x00 to 0x7F (0 – 127) are absolute milliseconds.Values from 0xF1 to 0xF9 are even 100 micro seconds.Every other value range is reserved and should not be used.</TUV>
</DESC>
<QUAL>CAN.StMin</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF6260FA10' oid='3D32A84DFBEB4443AE684F56AFD5F2E5' temploid='5535C0ECC4F74385BEB268AF6C959410' attrcatref='_000001FF6256B450' usage='sys' v='0' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Blocksize</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The Blocksize parameter indicates, how many consecutive frames shall be sent in a transmission before a flow control frame is sent. The number 0 tells the sender, that no more flow controls should disrupt the sending of the remaining flow controls</TUV>
</DESC>
<QUAL>CAN.Blocksize</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF6260F610' oid='FC07329C57F84d1aA67B1FFF28CC54B4' temploid='AE608BF1472549e0BE904D83A15582D4' attrcatref='_000001FF6256B510' usage='sys' v='1000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout As</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, sender side</TUV>
</DESC>
<QUAL>CAN.TimeoutAs</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF6260FE10' oid='33EA683DF633416490CBE69C59334F5D' temploid='EFCE99A5A52B47d99DCEF987DF3A7B10' attrcatref='_000001FF6256B510' usage='sys' v='1000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout Ar</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, receiver side</TUV>
</DESC>
<QUAL>CAN.TimeoutAr</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62610A10' oid='CFFBE88B85B3445dB185ECCE10148207' temploid='CAB50C54EB9545f38A85A4E58777B6AF' attrcatref='_000001FF6256B510' usage='sys' v='1000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout Bs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next flow control</TUV>
</DESC>
<QUAL>CAN.TimeoutBs</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62612610' oid='585D0E5325AC4e198DAD7F953CEF07CF' temploid='6AA7459CF3DA4f1aA663BB7C3811CA60' attrcatref='_000001FF6256B510' usage='sys' v='10' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Time Br</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for next transmission of flow control</TUV>
</DESC>
<QUAL>CAN.TimeBr</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62611810' oid='74001B5895DC46dc86D32135EC9A6EFD' temploid='C5575B04EA73449e9A15AB30619E19F7' attrcatref='_000001FF6256B510' usage='sys' v='10' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Time Cs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until next transmission of consecutive frame</TUV>
</DESC>
<QUAL>CAN.TimeCs</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62610010' oid='E25DC0D2165A4d07936A53B74E51813B' temploid='6560F131D61C416cB5FD678C7776D5A7' attrcatref='_000001FF6256B510' usage='sys' v='1000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout Cr</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next consecutive frame</TUV>
</DESC>
<QUAL>CAN.TimeoutCr</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62610C10' oid='A3068AC65DBE4368AC3823500838B429' temploid='4EF79462693C4617B394D987AE6122CC' attrcatref='_000001FF6256B450' usage='sys' v='4095' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Max Length of TP Message</TUV>
</NAME>
<QUAL>CAN.MaxLengthTpMessage</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62612A10' oid='949B72ED9FC54618938C8EBBF37E30D6' temploid='C255AA9A58AC4fbdA74FD391614BC428' attrcatref='_000001FF6256B450' usage='sys' v='500000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Baudrate</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Bus Speed of the used transport media. Caution, the Bus Speed has to be set identical in all ECUs connected to one subnet.</TUV>
</DESC>
<QUAL>CAN.Baudrate</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62612410' oid='3351013FFC52474e9D850DF198BDFDC0' temploid='8114C6FE9DFE40caAFF9E1710BD5280D' attrcatref='_000001FF6256B450' usage='sys' v='0' df='hex'>
<NAME>
<TUV xml:lang='en-US'>CANFrameFillerByte</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Fill byte used for filling CAN frames to eight byte length.</TUV>
</DESC>
<QUAL>CAN.CANFrameFillerByte</QUAL>
</UNSDEF>
<ENUMDEF id='_000001FF6260CF50' oid='E6C4FF73394E4df083488185013CD7C8' temploid='4AF233532E5B4aa98B23A6A6E08E6EB4' attrcatref='_000001FF6256B450' usage='sys' v='1' sort='id'>
<NAME>
<TUV xml:lang='en-US'>FillerByteHandling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enables use of fill bytes; if "true", fill bytes are used, otherwise DLC may be smaller than 8.</TUV>
</DESC>
<QUAL>CAN.FillerByteHandling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>false</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>true</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_000001FF6260D520' oid='FA268A3EC0AA4ce69990B966B73C865A' temploid='9140ACFA97F74f9bBF3A4EF8A0E67725' attrcatref='_000001FF6256B2D0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>FlexRay (ISO10681 TP)</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Communication interface for FlexRay protocol. Based on the specification: ISO10681-2 "Road vehicles —  Communication on FlexRay —  Part 2: Communication Layer services". ISO document date 2009-10-23.</TUV>
</DESC>
<QUAL>FlexRay_ISO</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>not supported</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>supported</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_000001FF6260D710' oid='360697355B2E4649B669B35E514692C6' temploid='33CEBBC4A37D42e9864330AA45647A0B' attrcatref='_000001FF6256B450' usage='admin' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>BusType</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Type of transport media.</TUV>
</DESC>
<QUAL>FlexRay_ISO.BusType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>FlexRay</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_000001FF62610210' oid='872DB009D7784439943BD61B2049B6DC' temploid='70F7576FC2FE4822A04B83E47CD338B4' attrcatref='_000001FF6256B510' usage='admin' v='150' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Timeout for the client to wait after the successful transmission of a request message for the start of incoming response messages. In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>FlexRay_ISO.CP_P2Max</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62612010' oid='96E95028A49346efA263CF8C0D58BAAC' temploid='8EC2C7175F2B4d818E1022DACCFA3FDB' attrcatref='_000001FF6256B510' usage='admin' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Performance requirement for the server to start with the response message after the reception of a request message. In UDS this is the timeout for the default session.The tester will also require the P2Server timeout, since in UDS service "DiagnosticSessionControl" returns the P2Server and P2*Server timeouts – the tester has to calculate the offset manually and has to add it to the returned P2Server and P2*Server timeouts.</TUV>
</DESC>
<QUAL>FlexRay_ISO.CP_P2Max_Ecu</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62610410' oid='CE42761FBE0047f49A846591D8C09594' temploid='BD3EFAECE9A94870820237F2681570F1' attrcatref='_000001FF6256B510' usage='admin' v='2000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2ExClient</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enhanced timeout for the client to wait after the reception of a negative response message with response code 78 hex for the start of incoming response messages. In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>FlexRay_ISO.CP_P2Star</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62610610' oid='F350E9B13DB84a69B2075E11843BDFB6' temploid='84FB63DDF991405eB1962B6090375E6B' attrcatref='_000001FF6256B510' usage='admin' v='1950' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2ExServer</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Performance requirement for the server to start with the response message after the transmission of a negative response message with response code 78 hex (enhanced response timing). In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>FlexRay_ISO.CP_P2Star_Ecu</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62610810' oid='45B11B15E76D4d9cAA12F908CC7E01E3' temploid='029A47066FD647c4B72C2B560271E12B' attrcatref='_000001FF6256B510' usage='admin' v='4000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>S3Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time between functionally addressed Tester Present request messages transmitted by the client to keep a diagnostic session other than the defaultSession active in multiple servers (functional communication) or maximum time between physically transmitted request messages to a single server (physical communication).</TUV>
</DESC>
<QUAL>FlexRay_ISO.CP_TesterPresentTime</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62611010' oid='342BBB840F704af0895438415556C866' temploid='1AC44FF91BD849239B3ACE94FFE11CA7' attrcatref='_000001FF6256B510' usage='admin' v='5000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>S3Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for the server to keep a diagnostic session other than the defaultSession active while not receiving any diagnostic request message.</TUV>
</DESC>
<QUAL>FlexRay_ISO.CP_TesterPresentTime_Ecu</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62611210' oid='335948905E434cebB4D6639EBB59BB72' temploid='C8C69719A4CA4aa1A9738A21A869B818' attrcatref='_000001FF6256B510' usage='admin' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P3ClientPhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Minimum time for the client to wait after the successful transmission of a physically addressed request message with no response required before it can transmit the next physically addressed request message. Minimum value = P2Server.</TUV>
</DESC>
<QUAL>FlexRay_ISO.CP_P3Phys</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62611610' oid='5D65184F6D9F48da8DD89D049B7ABF4E' temploid='0CC842BEF51C4983B9947BE3CD20A1D4' attrcatref='_000001FF6256B450' usage='admin' v='17476' df='hex'>
<NAME>
<TUV xml:lang='en-US'>EcuAddress</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Defines the ecu address. Messages addressed to the ecu will contain this address as target address within the message header.</TUV>
</DESC>
<QUAL>FlexRay_ISO.EcuAddress</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62611A10' oid='56540C8E74BC45f6A06698F0EDF028E7' temploid='AD158C32DBBE489c8196B940E0E4A4AA' attrcatref='_000001FF6256B450' usage='admin' v='4660' df='hex'>
<NAME>
<TUV xml:lang='en-US'>TesterAddress</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Defines the tester address. Messages addressed to the ecu will contain this address as source address within the message header.</TUV>
</DESC>
<QUAL>FlexRay_ISO.TesterAddress</QUAL>
</UNSDEF>
<CSTRDEF id='_000001FF625169D0' oid='D16EBF70708A4a558EB774189D7E09E5' temploid='B200EA78E1A549afB8DC166BABC13460' attrcatref='_000001FF6256B450' usage='admin'>
<NAME>
<TUV xml:lang='en-US'>PDUListReqPhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Describes the physical request channel. Can be single PDU or multiple Slots (comma separated list).</TUV>
</DESC>
<QUAL>FlexRay_ISO.PDUListReqPhys</QUAL>
<COMMONSTRING></COMMONSTRING>
</CSTRDEF>
<CSTRDEF id='_000001FF62515530' oid='2965D4A22CCA4491BF10FD1951AC6416' temploid='68D2120C1F60404f87CE55D4C6EB2938' attrcatref='_000001FF6256B450' usage='admin'>
<NAME>
<TUV xml:lang='en-US'>PDUListRes</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Describes the physical response channel. Can be single PDU or multiple Slots (comma separated list).</TUV>
</DESC>
<QUAL>FlexRay_ISO.PDUListRes</QUAL>
<COMMONSTRING></COMMONSTRING>
</CSTRDEF>
<ENUMDEF id='_000001FF6260C790' oid='B0C7392C420841fbA6A2A6053F42D1D4' temploid='8DB2F87211044f2d9CA09184F740E135' attrcatref='_000001FF6256B450' usage='admin' v='1' sort='id'>
<NAME>
<TUV xml:lang='en-US'>FillerByteHandling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enables or disables frame padding (0 = false, 1 = true).</TUV>
</DESC>
<QUAL>FlexRay_ISO.FillerByteHandling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>false</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>true</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_000001FF62611C10' oid='4E190C72F8234ca8BFDF4E27D6003B79' temploid='E73A82A5B97D4b2784C2B26F242B63DD' attrcatref='_000001FF6256B450' usage='admin' v='0' df='hex'>
<NAME>
<TUV xml:lang='en-US'>FrFrameFillerByte</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Byte value that is used for frame padding, if padding is enabled.</TUV>
</DESC>
<QUAL>FlexRay_ISO.FrFrameFillerByte</QUAL>
</UNSDEF>
<ENUMDEF id='_000001FF6260DAF0' oid='F91FEBD6734247e585B3B09144A39886' temploid='DCBABFB31D604897B9E4DE06F05118BC' attrcatref='_000001FF6256B450' usage='admin' v='1' sort='id'>
<NAME>
<TUV xml:lang='en-US'>AutoP2Handling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Support ISO14229 DiagnosticSessionControl service's influence on P2 (P2Client and P2ExClient) timings. Depending on the configured value, the timings will be updated or not (0 = Disabled, 1 = Enabled).</TUV>
</DESC>
<QUAL>FlexRay_ISO.AutoP2Handling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Disabled</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>Enabled</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_000001FF6260C980' oid='D0EBCFEBCD674b369FDD53F7B0F9D3FF' temploid='F205B2F7B6DB4872A68F383931A14842' attrcatref='_000001FF6256B450' usage='admin' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>RC21Handling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Repetition mode in case of KWP2000 negative response code 0x21 busy – repeat request (0 = Disabled, 1 = Enabled, 2 = EnabledUnlimited).</TUV>
</DESC>
<QUAL>FlexRay_ISO.RC21Handling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Disabled</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>Enabled</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>EnabledUnlimited</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_000001FF62611E10' oid='5E03F14B3697460090AF9B796AD68005' temploid='C2B4D1A56E6640d3AF4AC098B0361A70' attrcatref='_000001FF6256B510' usage='admin' v='10' df='dec'>
<NAME>
<TUV xml:lang='en-US'>RC21RequestTime</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time between negative response with response code 0x21 and the retransmission of the same request. If P3ClientPhys is greater than RC21RequestTime, the time delay prior to the retransmission of the same request will be P3ClientPhys.</TUV>
</DESC>
<QUAL>FlexRay_ISO.RC21RequestTime</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62612210' oid='C1E17EA8D78A486d85D8A16A40FFCB92' temploid='D6DA064AAF6D4c86A788F905E4B8424E' attrcatref='_000001FF6256B510' usage='admin' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>RC21CompletionTimeout</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time period the tester accepts repeated negative responses with response code 0x21 and repeats the same request. Timer is started after reception of first negative response.</TUV>
</DESC>
<QUAL>FlexRay_ISO.RC21CompletionTimeout</QUAL>
</UNSDEF>
<ENUMDEF id='_000001FF6260D900' oid='49E8116FDB794d1189B947530CA92300' temploid='94BF4EDEC6954ddb9384F01136C1ADBF' attrcatref='_000001FF6256B450' usage='admin' v='2' sort='id'>
<NAME>
<TUV xml:lang='en-US'>RC78Handling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Handling of 0x7F XX 0x78 ResponseTimeout and 0x78 repetitions (0 = Disabled, 1 = Enabled, 2 = EnabledUnlimited).</TUV>
</DESC>
<QUAL>FlexRay_ISO.RC78Handling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Disabled</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>Enabled</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>EnabledUnlimited</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_000001FF6264A9A0' oid='172B290D1EA5433e858B4910EE426F9A' temploid='2BF78B811A324c1c8044F4CE5BFA9A27' attrcatref='_000001FF6256B510' usage='admin' v='30000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>RC78CompletionTimeout</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time period the tester accepts repeated negative responses with response code 0x78 and waits for a positive response further on.</TUV>
</DESC>
<QUAL>FlexRay_ISO.RC78CompletionTimeout</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62648FA0' oid='0AC40A9EC3FA44e2A108CE4A888C8E93' temploid='1EEFB143154F46cbAC228B655D0E3465' attrcatref='_000001FF6256B510' usage='admin' v='125' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeoutAr</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, receiver side.</TUV>
</DESC>
<QUAL>FlexRay_ISO.TimeoutAr</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF626497A0' oid='52B8C6D6C2A4433c9ADE5C1237C80E47' temploid='D1E091DCEA58401d8E785E4F95701AB6' attrcatref='_000001FF6256B510' usage='admin' v='125' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeoutAs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, sender side.</TUV>
</DESC>
<QUAL>FlexRay_ISO.TimeoutAs</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF6264B1A0' oid='6DFC28854FD141ebA71AA14EFF317B5F' temploid='354CF428AFD94482B926762C57741C16' attrcatref='_000001FF6256B510' usage='admin' v='0' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeBr</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for next transmission of flow control.</TUV>
</DESC>
<QUAL>FlexRay_ISO.TimeBr</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF626499A0' oid='B18E1A0C22654c4e9E8733B53708702A' temploid='84D28D8C58874cc5B0B574605077DE69' attrcatref='_000001FF6256B510' usage='admin' v='150' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeoutBs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next flow control.</TUV>
</DESC>
<QUAL>FlexRay_ISO.TimeoutBs</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF6264B3A0' oid='81543AB59D4E4733A323021C57780CD8' temploid='A04A9E86B2B94caaA91E5C6795BD6737' attrcatref='_000001FF6256B510' usage='admin' v='150' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeoutCr</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next consecutive frame.</TUV>
</DESC>
<QUAL>FlexRay_ISO.TimeoutCr</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62647BA0' oid='D5B5B2F60E7A413d98DE36B2CDDDBFF8' temploid='837ABFA51F67400f9881644424C1C754' attrcatref='_000001FF6256B510' usage='admin' v='25' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeCs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until next transmission of consecutive frame.</TUV>
</DESC>
<QUAL>FlexRay_ISO.TimeCs</QUAL>
</UNSDEF>
<ENUMDEF id='_000001FF6260D140' oid='0D2504B86C514f03809DB084AD87BA74' temploid='9DF031080C154b54AECE6D726B3D6AC0' attrcatref='_000001FF6256B450' usage='admin' v='3' sort='id'>
<NAME>
<TUV xml:lang='en-US'>TransportProtocolType</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Describes the used FlexRay Transport Protocol Type (0 = Autosar2x, 1 = Autosar30, 2 = BMW, 3 = ISO10681).</TUV>
</DESC>
<QUAL>FlexRay_ISO.TransportProtocolType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Autosar2x</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>Autosar30</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>BMW</TUV>
</ETAG>
<ETAG v='3'>
<TUV xml:lang='en-US'>ISO10681</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_000001FF6260DCE0' oid='522087270F194af8945BB94B2F5346A1' temploid='521A0E12921B4ff7A6DB76FDC897E063' attrcatref='_000001FF6256B450' usage='admin' v='2' sort='id'>
<NAME>
<TUV xml:lang='en-US'>ConnectionModePhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Describes the Connection Mode for physical requests (1 = UnAckUnicast, 2 = AckUnicast, 3 = AckRetryUnicast).</TUV>
</DESC>
<QUAL>FlexRay_ISO.ConnectionModePhys</QUAL>
<ETAG v='1'>
<TUV xml:lang='en-US'>UnAckUnicast</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>AckUnicast</TUV>
</ETAG>
<ETAG v='3'>
<TUV xml:lang='en-US'>AckRetryUnicast</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_000001FF62648DA0' oid='263D2904CFE24fde9FE010744076F27D' temploid='4A9E565D49D9477aAEBEF8E627CCF9BE' attrcatref='_000001FF6256B450' usage='admin' v='0' df='dec'>
<NAME>
<TUV xml:lang='en-US'>BufferSize</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The  maximum  number  of  data  bytes  the  receiver  allows  the  sender  to  send  via  CFs, before  waiting  for  an  authorization  to  continue  transmission  of  the  following  data  bytes  via further CFs.</TUV>
</DESC>
<QUAL>FlexRay_ISO.BufferSize</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF6264ADA0' oid='96D7EA80682A4d95830BC12D2EF42B76' temploid='7C4DBA11629147e59A9B8E78043FED9B' attrcatref='_000001FF6256B450' usage='admin' v='0' df='dec'>
<NAME>
<TUV xml:lang='en-US'>BandwidthControl</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>By means of the BandwithControl (BC) parameter, the receiver reports its receiving performance level to the sender, i.e. the maximum bandwidth it can receive. The BC parameter is a one byte value.</TUV>
</DESC>
<QUAL>FlexRay_ISO.BandwidthControl</QUAL>
</UNSDEF>
<ENUMDEF id='_000001FF7BF2D840' oid='FF5B68A208E049b9B60EE84056EE669A' temploid='32A3C96F7AA34c39B4C850C47F9F71BF' attrcatref='_000001FF6256B2D0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>FlexRay (Autosar2x TP)</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Communication interface for FlexRay protocol. Based on the Autosar2x specific transport protocol.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>not supported</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>supported</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_000001FF7BF2CE90' oid='31F65673F2DF4748AC9D56C3BA9E9BCE' temploid='BD9E41A1968E4e3f9C8E6AF913209C6A' attrcatref='_000001FF6256B450' usage='admin' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>BusType</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Type of transport media.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.BusType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>FlexRay</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_000001FF62649FA0' oid='DC4DF4DC45484b5fA4FF50A8AEF0C93D' temploid='6E4757A190FE46889462329EED761870' attrcatref='_000001FF6256B510' usage='admin' v='150' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Timeout for the client to wait after the successful transmission of a request message for the start of incoming response messages. In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.CP_P2Max</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF6264B5A0' oid='B1591F277C8542c09BB8E2AC9B7C286C' temploid='A9ED920EA45940219DB2B66C77B4F05C' attrcatref='_000001FF6256B510' usage='admin' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Performance requirement for the server to start with the response message after the reception of a request message. In UDS this is the timeout for the default session.The tester will also require the P2Server timeout, since in UDS service "DiagnosticSessionControl" returns the P2Server and P2*Server timeouts – the tester has to calculate the offset manually and has to add it to the returned P2Server and P2*Server timeouts.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.CP_P2Max_Ecu</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF6264ABA0' oid='C7D80DDA1E6C4b81908870D75B7E1930' temploid='D878BEE8217540be9FDE0C6832D71C8D' attrcatref='_000001FF6256B510' usage='admin' v='2000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2ExClient</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enhanced timeout for the client to wait after the reception of a negative response message with response code 78 hex for the start of incoming response messages. In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.CP_P2Star</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF626491A0' oid='57701EFA094246ba96F7B90E80B5204B' temploid='632B7BC788384317809CC3DD68315FCE' attrcatref='_000001FF6256B510' usage='admin' v='1950' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2ExServer</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Performance requirement for the server to start with the response message after the transmission of a negative response message with response code 78 hex (enhanced response timing). In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.CP_P2Star_Ecu</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF626479A0' oid='DBBB9EC95804491a9B30BCD7DC24FA68' temploid='C930B65DE35E47d096EDC6DE61AD39EC' attrcatref='_000001FF6256B510' usage='admin' v='4000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>S3Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time between functionally addressed Tester Present request messages transmitted by the client to keep a diagnostic session other than the defaultSession active in multiple servers (functional communication) or maximum time between physically transmitted request messages to a single server (physical communication).</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.CP_TesterPresentTime</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62648BA0' oid='1320753A3DE34238A2C0518C8E84F745' temploid='8883A3FDEDED4235B593497A15AC0730' attrcatref='_000001FF6256B510' usage='admin' v='5000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>S3Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for the server to keep a diagnostic session other than the defaultSession active while not receiving any diagnostic request message.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.CP_TesterPresentTime_Ecu</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62647DA0' oid='7163F5F7FF8E4943A90D7948D5194D90' temploid='5F401A1E9BA14b49B8109428C9BF85C5' attrcatref='_000001FF6256B510' usage='admin' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P3ClientPhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Minimum time for the client to wait after the successful transmission of a physically addressed request message with no response required before it can transmit the next physically addressed request message. Minimum value = P2Server.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.CP_P3Phys</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF626485A0' oid='EDA66E631C9C4122B54E93C70B33BA55' temploid='54151AAD5ABF403eA5CFE80E63E403A0' attrcatref='_000001FF6256B450' usage='admin' v='17476' df='hex'>
<NAME>
<TUV xml:lang='en-US'>EcuAddress</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Defines the ecu address. Messages addressed to the ecu will contain this address as target address within the message header.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.EcuAddress</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62647FA0' oid='57062FA49F4344ddB28F819D3E5A83CB' temploid='1CB805F360DB4ed08C26C250C312F0C4' attrcatref='_000001FF6256B450' usage='admin' v='4660' df='hex'>
<NAME>
<TUV xml:lang='en-US'>TesterAddress</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Defines the tester address. Messages addressed to the ecu will contain this address as source address within the message header.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.TesterAddress</QUAL>
</UNSDEF>
<CSTRDEF id='_000001FF625158F0' oid='3B685039518D4259B4CEA741E94D14D6' temploid='B4D69B1B1E494dedA5872F3FDC9D1F45' attrcatref='_000001FF6256B450' usage='admin'>
<NAME>
<TUV xml:lang='en-US'>PDUListReqPhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Describes the physical request channel. Can be single PDU or multiple Slots (comma separated list).</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.PDUListReqPhys</QUAL>
<COMMONSTRING></COMMONSTRING>
</CSTRDEF>
<CSTRDEF id='_000001FF625167F0' oid='3A5C3584E8EE43fe8FA716336A86B1E5' temploid='11C421A54B224f67951029A4F6F71E73' attrcatref='_000001FF6256B450' usage='admin'>
<NAME>
<TUV xml:lang='en-US'>PDUListRes</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Describes the physical response channel. Can be single PDU or multiple Slots (comma separated list).</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.PDUListRes</QUAL>
<COMMONSTRING></COMMONSTRING>
</CSTRDEF>
<ENUMDEF id='_000001FF7BF2C2F0' oid='96C5831A829D40af8B1B21C638D7CDC5' temploid='D4EC4ACB48D24f59B4F5C5641D6E1700' attrcatref='_000001FF6256B450' usage='admin' v='1' sort='id'>
<NAME>
<TUV xml:lang='en-US'>FillerByteHandling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enables or disables frame padding (0 = false, 1 = true).</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.FillerByteHandling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>false</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>true</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_000001FF6264A1A0' oid='500E5D3F70004a2d842BC918FC166E2E' temploid='934EF1A297C84a508F66D02197BA834A' attrcatref='_000001FF6256B450' usage='admin' v='0' df='hex'>
<NAME>
<TUV xml:lang='en-US'>FrFrameFillerByte</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Byte value that is used for frame padding, if padding is enabled.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.FrFrameFillerByte</QUAL>
</UNSDEF>
<ENUMDEF id='_000001FF7BF2DA30' oid='7138ABB0135B4390837F344FC8CC3C15' temploid='6500441CC5244372BEFFA6C9B0806174' attrcatref='_000001FF6256B450' usage='admin' v='1' sort='id'>
<NAME>
<TUV xml:lang='en-US'>AutoP2Handling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Support ISO14229 DiagnosticSessionControl service's influence on P2 (P2Client and P2ExClient) timings. Depending on the configured value, the timings will be updated or not (0 = Disabled, 1 = Enabled).</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.AutoP2Handling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Disabled</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>Enabled</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_000001FF7BF2C4E0' oid='5399CAF70DD74961986F69E9408DEC1C' temploid='5FDD91F76BA94698A59E5B061D122E44' attrcatref='_000001FF6256B450' usage='admin' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>RC21Handling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Repetition mode in case of KWP2000 negative response code 0x21 busy – repeat request (0 = Disabled, 1 = Enabled, 2 = EnabledUnlimited).</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.RC21Handling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Disabled</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>Enabled</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>EnabledUnlimited</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_000001FF6264A3A0' oid='D90C2A1D102F47c2BB3DE8AED97A820A' temploid='6D6BC198D69E4456A13AA2D596C01E06' attrcatref='_000001FF6256B510' usage='admin' v='10' df='dec'>
<NAME>
<TUV xml:lang='en-US'>RC21RequestTime</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time between negative response with response code 0x21 and the retransmission of the same request. If P3ClientPhys is greater than RC21RequestTime, the time delay prior to the retransmission of the same request will be P3ClientPhys.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.RC21RequestTime</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF626493A0' oid='C0A6713B1C914ea1BF7B180A5D59F08B' temploid='E825BA4142BB406aB7653A854A89FEE8' attrcatref='_000001FF6256B510' usage='admin' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>RC21CompletionTimeout</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time period the tester accepts repeated negative responses with response code 0x21 and repeats the same request. Timer is started after reception of first negative response.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.RC21CompletionTimeout</QUAL>
</UNSDEF>
<ENUMDEF id='_000001FF7BF2C6D0' oid='909F980C41CC4f24B60E14E807EBF443' temploid='2F76FB3BE60E4938821E4D5B2A752F8A' attrcatref='_000001FF6256B450' usage='admin' v='2' sort='id'>
<NAME>
<TUV xml:lang='en-US'>RC78Handling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Handling of 0x7F XX 0x78 ResponseTimeout and 0x78 repetitions (0 = Disabled, 1 = Enabled, 2 = EnabledUnlimited).</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.RC78Handling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Disabled</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>Enabled</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>EnabledUnlimited</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_000001FF6264A5A0' oid='630F42916C494fe3B47BFF1E5967F2AD' temploid='16820517C2424af29D328640DD8C2838' attrcatref='_000001FF6256B510' usage='admin' v='30000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>RC78CompletionTimeout</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time period the tester accepts repeated negative responses with response code 0x78 and waits for a positive response further on.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.RC78CompletionTimeout</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF6264A7A0' oid='E7FC80A06A6E4f3a98EF4DADDCE2988D' temploid='396C69C6664E440b88F1FF12D34AC5FF' attrcatref='_000001FF6256B510' usage='admin' v='125' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeoutAr</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, receiver side.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.TimeoutAr</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF626481A0' oid='82D45BC2DAAE494bA711CCC97E61027D' temploid='B7AA8A765BE54a93BB4F88F62A396D21' attrcatref='_000001FF6256B510' usage='admin' v='125' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeoutAs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, sender side.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.TimeoutAs</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF626483A0' oid='79693CD8DDA343e2A3A3699126C93461' temploid='E54498A726E44f8896AC346FDF1CA3F6' attrcatref='_000001FF6256B510' usage='admin' v='0' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeBr</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for next transmission of flow control.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.TimeBr</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62649DA0' oid='036FF9FB835349fe8D897055734B93D9' temploid='8BDA3F5AE07B41ca8E81E2D1B9CF7CD2' attrcatref='_000001FF6256B510' usage='admin' v='150' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeoutBs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next flow control.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.TimeoutBs</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF626487A0' oid='C110440BDAB54db894F4C202F7B2E5E9' temploid='349ED325C93545cb9E3304432EBA13F4' attrcatref='_000001FF6256B510' usage='admin' v='150' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeoutCr</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next consecutive frame.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.TimeoutCr</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF62649BA0' oid='1445CADA2C17490087C16EBFC32A7A12' temploid='42BCD1EF169741e1B69634578F8676A2' attrcatref='_000001FF6256B510' usage='admin' v='25' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TimeCs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until next transmission of consecutive frame.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.TimeCs</QUAL>
</UNSDEF>
<ENUMDEF id='_000001FF7BF2D080' oid='9AA984D41B814d0e97BCE4ADEB36EE68' temploid='334FB71DB7E84bc4854CF227622DFF90' attrcatref='_000001FF6256B450' usage='admin' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>TransportProtocolType</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Describes the used FlexRay Transport Protocol Type (0 = Autosar2x, 1 = Autosar30, 2 = BMW, 3 = ISO10681).</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.TransportProtocolType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Autosar2x</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>Autosar30</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>BMW</TUV>
</ETAG>
<ETAG v='3'>
<TUV xml:lang='en-US'>ISO10681</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_000001FF7BF2C8C0' oid='1D45D884E5044dfeB6767E9425657A5A' temploid='1F6DB6AC8D814fd8B9D59214FD564134' attrcatref='_000001FF6256B450' usage='admin' v='2' sort='id'>
<NAME>
<TUV xml:lang='en-US'>ConnectionModePhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Describes the Connection Mode for physical requests (1 = UnAckUnicast, 2 = AckUnicast, 3 = AckRetryUnicast).</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.ConnectionModePhys</QUAL>
<ETAG v='1'>
<TUV xml:lang='en-US'>UnAckUnicast</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>AckUnicast</TUV>
</ETAG>
<ETAG v='3'>
<TUV xml:lang='en-US'>AckRetryUnicast</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_000001FF7BF2DC20' oid='5C6106B24B4B4a9cA1F59A57CC3ABF7F' temploid='97CA9B86154847e28BACB06B8C42E8DF' attrcatref='_000001FF6256B450' usage='admin' v='3' sort='id'>
<NAME>
<TUV xml:lang='en-US'>MessageLength</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Message Length of physically addressed request (= message length mode (Autosar FlexRay TP 2.1, 10.2.3): ISO = 1 (up to 4095 bytes, do not use extended frame types), ISO6 = 2 (as ISO, but payload length is limited to 6 bytes), L16M = 3 (up to 2^24-1 bytes, E4 frames not allowed), L4G = 4 (up to 2^32-1 bytes, all frames allowed).</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.MessageLengthPhys</QUAL>
<ETAG v='1'>
<TUV xml:lang='en-US'>ISO</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>ISO6</TUV>
</ETAG>
<ETAG v='3'>
<TUV xml:lang='en-US'>L16M</TUV>
</ETAG>
<ETAG v='4'>
<TUV xml:lang='en-US'>L4G</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_000001FF626495A0' oid='45BE02BC32784d4781E531F362CFF678' temploid='82B4B7AA84234210BF00938160962744' attrcatref='_000001FF6256B450' usage='admin' v='0' df='dec'>
<NAME>
<TUV xml:lang='en-US'>BlockSize</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The Block Size parameter indicates, how many consecutive frames shall be sent in a transmission before a flow control frame is sent. The number 0 tells the sender, that no more flow controls should disrupt the sending of the remaining flow controls.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.BlockSize</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF6264AFA0' oid='F77D1B6D11EF4cb1A73C3DFCCC283986' temploid='E6DBF459978849418B19F9B66037DAD5' attrcatref='_000001FF6256B450' usage='admin' v='20' df='dec'>
<NAME>
<TUV xml:lang='en-US'>SeparationTime</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Separation Time defines the minimum time gap between consecutive frames. Values from 0x00 to 0x7F (0 – 127) are absolute milliseconds. Values from 0xF1 to 0xF9 are even 100 micro seconds. Every other value range is reserved and should not be used.</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.StMin</QUAL>
</UNSDEF>
<ENUMDEF id='_000001FF7BF2CCA0' oid='825B6906D45F4d53A69B2B442B449082' temploid='74872A8635B64042BB1F8CC5A66F0FD7' attrcatref='_000001FF6256B450' usage='admin' v='2' sort='id'>
<NAME>
<TUV xml:lang='en-US'>AddressTypePhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Describes the number of address bytes used within the header of physically addressed messages (1 = 1 byte addresses, 2 = 2 byte addresses).</TUV>
</DESC>
<QUAL>FlexRay_Autosar2x.AddressTypePhys</QUAL>
<ETAG v='1'>
<TUV xml:lang='en-US'>1</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>2</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_000001FF7BF2D270' oid='B2FBCDD55F584d93981A532E2240D531' temploid='6EF520FB4D0F4063B1A8DF0E69763B30' attrcatref='_000001FF6256B450' usage='admin' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>RC21Handling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Repetition mode in case of negative response code 0x21 (busy – repeat request)</TUV>
</DESC>
<QUAL>CAN.RC21Handling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Disabled</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>Enabled</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>EnabledUnlimited</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_000001FF7BF48360' oid='CA91B4ADADBD4b8980DE7E9BDF3E2ADA' temploid='61C80B8BCC7D427dBBEF92C8405BF9C1' attrcatref='_000001FF6256B510' usage='admin' v='10' df='dec'>
<NAME>
<TUV xml:lang='en-US'>RC21RequestTime</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time between negative response with response code 0x21 and the retransmission of the same request. If P3ClientPhys is greater than RC21RequestTime, the time delay prior to the retransmission of the same request will be P3ClientPhys.</TUV>
</DESC>
<QUAL>CAN.RC21RequestTime</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF7BF48F60' oid='449A572FDFC04edd8C18B3704B89F335' temploid='0A341948E43544d887C13C5D324C0C9E' attrcatref='_000001FF6256B510' usage='admin' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>RC21CompletionTimeout</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time period the tester accepts repeated negative responses with response code 0x21 and repeats the same request. Timer is started after reception of first negative response.</TUV>
</DESC>
<QUAL>CAN.RC21CompletionTimeout</QUAL>
</UNSDEF>
<ENUMDEF id='_000001FF7BF4BC90' oid='3C821E1CD7B341caB175292B7E8988C2' temploid='7268DB599AC64e5d9675DC146B26FEFF' attrcatref='_000001FF6256B450' usage='admin' v='2' sort='id'>
<NAME>
<TUV xml:lang='en-US'>RC78Handling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Handling of 0x7F XX 0x78 ResponseTimeout and 0x78 Repetitions</TUV>
</DESC>
<QUAL>CAN.RC78Handling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Disabled</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>Enabled</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>EnabledUnlimited</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_000001FF7BF46160' oid='A2A0BF2C0E8D4da385F8C02B742D0957' temploid='1675EDE511E34a08967F2E7DBD849291' attrcatref='_000001FF6256B510' usage='admin' v='30000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>RC78CompletionTimeout</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time period the tester accepts repeated negative responses with response code 0x78 and waits for a positive response further on</TUV>
</DESC>
<QUAL>CAN.RC78CompletionTimeout</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF7BF46360' oid='74B1372B30AE4aa7801A9A7231B7A1CA' temploid='A08F84D629CC4cd99C36F8828F0531C1' attrcatref='_000001FF6246B330' v='1000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Periodic Rate (Slow) in ms</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Only exported if Service $2A with transmissionMode $01 (sendAtSlowRate) is supported.</TUV>
</DESC>
<QUAL>Periodic_Rate_Slow_in_ms</QUAL>
</UNSDEF>
<UNSDEF id='_000001FF7BF47B60' oid='E9FE200058254f539AE3D05BC2A3F22B' temploid='FBE63A8D027B419394833B66F9950CA4' attrcatref='_000001FF6246B330' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Periodic Rate (Medium) in ms</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Only exported if Service $2A with transmissionMode $02 (sendAtMediumRate) is supported.</TUV>
</DESC>
<QUAL>Periodic_Rate_Medium_in_ms</QUAL>
</UNSDEF>

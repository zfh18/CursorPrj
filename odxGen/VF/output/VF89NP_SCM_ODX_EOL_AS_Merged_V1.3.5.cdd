<ENUMDEF id="_000001FEAF703AF0" oid="5EAF412FE07B488aA7501A70C3D43A16" temploid="9ECCE7FD714B4accBC2CC8FC7A7EADCF" attrcatref="_000001FEAF652D30" restr="SecurityAccessPowertrain_Diagnostic_and_Freeze_Frame_DataEmission_related_Trouble_CodesOnboard_Monitoring_Test_Results_for_Specific_Monitored_SystemsControl_of_Onboard_Systems_Test_or_ControlVehicle_Information" v="0" sort="id">
<NAME>
<TUV xml:lang="en-US">Static_Seed</TUV>
</NAME>
<DESC>
<TUV xml:lang="en-US">This is used to indicate whether or not a static_seed is used or not for non-standard security algorithms.  This value shall always be false if Delay_Timer and Att_Cnt are not supported.</TUV>
</DESC>
<QUAL>Static_Seed</QUAL>
<ETAG v="0">
<TUV xml:lang="en-US">False</TUV>
</ETAG>
<ETAG v="1">
<TUV xml:lang="en-US">True</TUV>
</ETAG>
</ENUMDEF>
<CSTRDEF id="_000001FEAF6F6F10" oid="EDF4943C48874ceaB25ADDB950028AEA" temploid="7F608A1246C140468B53AAECBE1786AE" attrcatref="_000001FEAF54B090" restr="IOControlRoutine_Control" listable="1">
<NAME>
<TUV xml:lang="en-US">Instance Type</TUV>
</NAME>
<QUAL>Instance_Type</QUAL>
<COMMONSTRING/>
</CSTRDEF>
<CSTRDEF id="_000001FEAF6F70F0" oid="DC73111173A241f1A55FDD47FECB57AC" temploid="E4EA632F6CE4455599BAFF1724C03CD6" attrcatref="_000001FEAF54B090">
<NAME>
<TUV xml:lang="en-US">ASR SWC DataElement Ref</TUV>
</NAME>
<DESC>
<TUV xml:lang="en-US">Path to the system description data element which corresponds to the CANdela object. It is set by the SWC Sync and evaluated by DEXT export.</TUV>
</DESC>
<QUAL>ASR_SWC_DataElement_Ref</QUAL>
<COMMONSTRING/>
</CSTRDEF>
<CSTRDEF id="_000001FEAF6F7870" oid="EF6E005754534d6aBB65CC6C54A5FBEC" temploid="838D7847DA66406684C6C6871EDF7280" attrcatref="_000001FEAF54B090">
<NAME>
<TUV xml:lang="en-US">ASR SWC ServiceDependency Ref</TUV>
</NAME>
<DESC>
<TUV xml:lang="en-US">Path to the system description service dependency which corresponds to the CANdela diagnostic instance. It is set by SWC Sync and evaluated by DEXT export.</TUV>
</DESC>
<QUAL>ASR_SWC_ServiceDependency_Ref</QUAL>
<COMMONSTRING/>
</CSTRDEF>
<CSTRDEF id="_000001FEAF6F8770" oid="557b111594335ab8b16c45957309ee69" attrcatref="_000001FEAF54B090">
<NAME>
<TUV xml:lang="en-US">ASR UUID</TUV>
</NAME>
<DESC>
<TUV xml:lang="en-US">UUID of the synchronized AUTOSAR element which corresponds to the diagnostic instance.</TUV>
</DESC>
<QUAL>ASR_UUID</QUAL>
<COMMONSTRING/>
</CSTRDEF>
<CSTRDEF id="_000001FEAF6F83B0" oid="e9e04fe0f63a55fd8fbf7d483c40e388" attrcatref="_000001FEAF54A850">
<NAME>
<TUV xml:lang="en-US">SYNCHELEMENT</TUV>
</NAME>
<QUAL>SYNCHELEMENT</QUAL>
<COMMONSTRING/>
</CSTRDEF>
<UNSDEF id="_000001FEAF6A3280" oid="26f990bd0b5157beb78d52afb510bc81" attrcatref="_000001FEAF54B210" restr="ECU_IdentificationVariant_CodingStored_DataDynamic_DataPeriodic_DataIOControl" v="0" df="dec">
<NAME>
<TUV xml:lang="en-US">ASR3 Legacy Combine DID</TUV>
</NAME>
<DESC>
<TUV xml:lang="en-US">If non-zero, DEXT export creates one element for the entire DID described in the Diagnostic Instance. Set this to simplify the port mapping (but the software component must unpack the element to get at the DID data). The data type of the combined data element is a byte array.</TUV>
</DESC>
<QUAL>ASR3_Legacy_Combine_DID</QUAL>
</UNSDEF>
<UNSDEF id="_000001FEAF6A3680" oid="a490f991d548543b9b496025ce3e27fa" attrcatref="_000001FEAF54B210" restr="Routine_ControlPowertrain_Diagnostic_and_Freeze_Frame_DataOnboard_Monitoring_Test_Results_for_Specific_Monitored_SystemsControl_of_Onboard_Systems_Test_or_Control" v="0" df="dec">
<NAME>
<TUV xml:lang="en-US">ASR3 Legacy Combine Routine</TUV>
</NAME>
<DESC>
<TUV xml:lang="en-US">If non-zero, DEXT export creates one combined data element for all routine parameters, instead of individual elements. Set this to simplify the port mapping (but the software component must unpack the element to get at the routine parameters). The data type of the combined data element is a byte array.</TUV>
</DESC>
<QUAL>ASR3_Legacy_Combine_Routine</QUAL>
</UNSDEF>

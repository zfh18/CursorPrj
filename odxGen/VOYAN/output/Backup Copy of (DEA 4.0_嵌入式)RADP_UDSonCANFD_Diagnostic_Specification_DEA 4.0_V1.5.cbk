<ENUMDEF id='_0000024830D57070' oid='0DE054962871496185D998DF35BDA207' temploid='B826D8E7342C465c94DBC62C82208050' attrcatref='_0000024830A55B90' usage='admin' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Bus Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Type of transport media</TUV>
</DESC>
<QUAL>CAN_FD.BusType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>CAN</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000024830D57C10' oid='12E3AF7B37BA4b99A866FC50A240F238' temploid='7B41FBAA8B6649de887ECFB7FC19AFD7' attrcatref='_0000024830A55B90' usage='admin' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Transport Protocol Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Type of used Transport Protocol (e.g. ISO15765)</TUV>
</DESC>
<QUAL>CAN_FD.TransportProtocolType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>ISO15765</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000024830D564D0' oid='FB39551155064c22B41FC6A569BB08B2' temploid='04839D0DFAE945f7A6A277816E6A4890' attrcatref='_0000024830A55B90' usage='admin' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Addressing Scheme</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Addressing Scheme used for physical requests and responses.</TUV>
</DESC>
<QUAL>CAN_FD.AddrScheme</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Normal</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000024830D56AA0' oid='4B01639635034348B880046F5CD95FD0' temploid='9E5E9E4160AB489683CFBD1A405BDE99' attrcatref='_0000024830A55B90' usage='admin' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>CAN-ID Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>CAN-ID Type used for physical requests and responses</TUV>
</DESC>
<QUAL>CAN_FD.CanIdType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>11-Bit</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>29-Bit</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_0000024830D3C6A0' oid='E027AC53A5D44fadB5DBF8106C18B16A' temploid='CC8C4465325F4cb9B5846B603892B484' attrcatref='_0000024830A55B90' usage='admin' v='1792' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Request CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The request CAN identifier for physical requests. The hex value not only describes the identifier but also the priority of the message. The higher the number, the lower the priority. </TUV>
</DESC>
<QUAL>CAN_FD.ReqCanId</QUAL>
</UNSDEF>
<UNSDEF id='_0000024830D3FAA0' oid='7A0DE53289B34c7bA99FA462AA30D30D' temploid='5AD9B630E9BD4efd972863CD9211E5C8' attrcatref='_0000024830A55B90' usage='admin' v='1536' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Response CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The response CAN identifier for physical responses. The response for functional requests is sent via the physical path.</TUV>
</DESC>
<QUAL>CAN_FD.ResCanId</QUAL>
</UNSDEF>
<UNSDEF id='_0000024830D3C8A0' oid='0DFF13EC6015469c9D31BC7C2976BB45' temploid='70C96221C7494ab4A9D4B8FB5FB64345' attrcatref='_0000024830A55D10' usage='admin' v='150' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Timeout for the client to wait after the successful transmission of a request message for the start of incoming response messages. In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>CAN_FD.P2Client</QUAL>
</UNSDEF>
<UNSDEF id='_0000024830D3E6A0' oid='EACF79AC57DF4d2792B91228F705A291' temploid='A933DA62F2534f72A59E59C72F38097F' attrcatref='_0000024830A55D10' usage='admin' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Performance requirement for the server to start with the response message after the reception of a request message. In UDS this is the timeout for the default session. The tester will also require the P2Server timeout, since in UDS service "DiagnosticSessionControl" returns the P2Server and P2*Server timeouts – the tester has to calculate the offset manually and has to add it to the returned P2Server and P2*Server timeouts.</TUV>
</DESC>
<QUAL>CAN_FD.P2Server</QUAL>
</UNSDEF>
<UNSDEF id='_0000024830D3CAA0' oid='60830065E0B24a19A81B73FC9836FD8C' temploid='BA85CF8C406C46f6BDC2B3ED7A849A42' attrcatref='_0000024830A55D10' usage='admin' v='5000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2*Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enhanced timeout for the client to wait after the reception of a negative response message with response code 78 hex for the start of incoming response messages. In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>CAN_FD.P2ExClient</QUAL>
</UNSDEF>
<UNSDEF id='_0000024830D3E8A0' oid='AE5A0C7E054D4fcc89CF59E5751FFFE1' temploid='F5296859AA734622A8D88B6A4F025201' attrcatref='_0000024830A55D10' usage='admin' v='4950' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2*Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Performance requirement for the server to start with the response message after the transmission of a negative response message with response code 78 hex (enhanced response timing). In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>CAN_FD.P2ExServer</QUAL>
</UNSDEF>
<UNSDEF id='_0000024830D3CCA0' oid='D5F96A699B5C4655B2138B955A972BE9' temploid='5D4BC7B1FFCB4d4f8DE37CA90AC046A1' attrcatref='_0000024830A55D10' usage='admin' v='4000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>S3Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time between functionally addressed Tester Present request messages transmitted by the client to keep a diagnostic session other than the defaultSession active in multiple servers (functional communication) or maximum time between physically transmitted request messages to a single server (physical communication).</TUV>
</DESC>
<QUAL>CAN_FD.S3Client</QUAL>
</UNSDEF>
<UNSDEF id='_0000024830D73870' oid='16A462EC2AD94d00817EFF07F299B6F1' temploid='2364F148775B4dfc8C4138250CCD1E7F' attrcatref='_0000024830A55D10' usage='admin' v='5000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>S3Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for the server to keep a diagnostic session other than the defaultSession active while not receiving any diagnostic request message</TUV>
</DESC>
<QUAL>CAN_FD.S3Server</QUAL>
</UNSDEF>
<UNSDEF id='_0000024830D74E70' oid='7DDF9874092A40f0B64A86E0E28D970F' temploid='E81B9027EE5C4848BB23D17E41C1AFFD' attrcatref='_0000024830A55D10' usage='admin' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P3ClientPhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Minimum time for the client to wait after the successful transmission of a physically addressed request message (indicated via N_USData.con) with no response required before it can transmit the next physically addressed request message.
Minimum value = P2Server</TUV>
</DESC>
<QUAL>CAN_FD.P3ClientPhys</QUAL>
</UNSDEF>
<UNSDEF id='_0000024830D75C70' oid='F825AC89AB5A440aB1F45CDEB5494766' temploid='C0A84214DF8C496082D2D00F9B147563' attrcatref='_0000024830A55B90' usage='admin' v='15872' df='hex'>
<NAME>
<TUV xml:lang='en-US'>TesterPresentPhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Defines the TesterPresent message for physically addressed requests used to keep a diagnostic session active.</TUV>
</DESC>
<QUAL>CAN_FD.TesterPresentPhys</QUAL>
</UNSDEF>
<UNSDEF id='_0000024830D72070' oid='F43CD936125545e78F83D6F1F55B994D' temploid='9AE4F867003B4a389D389FE96334AC7F' attrcatref='_0000024830A55D10' usage='admin' v='0' df='dec'>
<NAME>
<TUV xml:lang='en-US'>STmin</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>(Separation Time) defines the minimum time gap between consecutive frames. Values from 0x00 to 0x7F (0 – 127) are absolute milliseconds.Values from 0xF1 to 0xF9 are even 100 micro seconds. Every other value range is reserved and should not be used.</TUV>
</DESC>
<QUAL>CAN_FD.StMin</QUAL>
</UNSDEF>
<UNSDEF id='_0000024830D74270' oid='48D5C655960A4d70A83F57FE01C237BA' temploid='FB1233775F004a539FAB9455911BA532' attrcatref='_0000024830A55B90' usage='admin' v='0' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Blocksize</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The Blocksize parameter indicates, how many consecutive frames shall be sent in a transmission before a flow control frame is sent. The number 0 tells the sender, that no more flow controls should disrupt the sending of the remaining flow controls</TUV>
</DESC>
<QUAL>CAN_FD.Blocksize</QUAL>
</UNSDEF>
<UNSDEF id='_0000024830D75A70' oid='3F9A37D4A2154540A4FA6DA1BAA4D3E8' temploid='6188767F961C4bd4A89313B9794350E7' attrcatref='_0000024830A55D10' usage='admin' v='1000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout As</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, sender side</TUV>
</DESC>
<QUAL>CAN_FD.TimeoutAs</QUAL>
</UNSDEF>
<UNSDEF id='_0000024830D74C70' oid='F6509A0CE45746d2BA0FB7397796AB9B' temploid='583C9BD2772F4088B7D3B58343446987' attrcatref='_0000024830A55D10' usage='admin' v='1000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout Ar</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, receiver side</TUV>
</DESC>
<QUAL>CAN_FD.TimeoutAr</QUAL>
</UNSDEF>
<UNSDEF id='_0000024830D75870' oid='F3FE621C6FBA415d857A3A9BF0C29ADA' temploid='14E4F8EEFE3D4bc2BEABF7ECE58C3375' attrcatref='_0000024830A55D10' usage='admin' v='1000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout Bs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next flow control</TUV>
</DESC>
<QUAL>CAN_FD.TimeoutBs</QUAL>
</UNSDEF>
<UNSDEF id='_0000024830D74870' oid='57D3E014FEB34118852EA311B60EC9BE' temploid='9ED4FB3C798A4eb0A76F4AE100F94547' attrcatref='_0000024830A55D10' usage='admin' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Time Br</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for next transmission of flow control</TUV>
</DESC>
<QUAL>CAN_FD.TimeBr</QUAL>
</UNSDEF>
<UNSDEF id='_0000024830D75070' oid='2B37992959D44cef889680E106C9CC59' temploid='3EA2E1BFA48D42dc88418B924EB908A8' attrcatref='_0000024830A55D10' usage='admin' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Time Cs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until next transmission of consecutive frame</TUV>
</DESC>
<QUAL>CAN_FD.TimeCs</QUAL>
</UNSDEF>
<UNSDEF id='_0000024830D73070' oid='517D4FC63B6643d79324358685E9F38F' temploid='9ECE8B4C74F546528268A8DAF7C66B4D' attrcatref='_0000024830A55D10' usage='admin' v='1000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout Cr</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next consecutive frame</TUV>
</DESC>
<QUAL>CAN_FD.TimeoutCr</QUAL>
</UNSDEF>
<UNSDEF id='_0000024830D73A70' oid='2EA06A1E58D743b7A4BDDEDE28E2ABC8' temploid='E8D20CA42B9A48958A55C189B99522FA' attrcatref='_0000024830A55B90' usage='admin' v='4095' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Max Length of TP Message</TUV>
</NAME>
<QUAL>CAN_FD.MaxLengthTpMessage</QUAL>
</UNSDEF>
<UNSDEF id='_0000024830D73C70' oid='5AF0E4F980B3442a9002B8F84E27E57C' temploid='5567B0694FCC4e709B4127C22EDAE186' attrcatref='_0000024830A55B90' usage='admin' v='500000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Baudrate</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Bus Speed of the used transport media. Caution, the Bus Speed has to be set identical in all ECUs connected to one subnet.</TUV>
</DESC>
<QUAL>CAN_FD.Baudrate</QUAL>
</UNSDEF>
<UNSDEF id='_0000024830D72670' oid='5EFCDFADBCC343bf80F47BC4EE677335' temploid='900296445FBB4299A04E62D37C7BC78C' attrcatref='_0000024830A55B90' usage='admin' v='0' df='hex'>
<NAME>
<TUV xml:lang='en-US'>CANFrameFillerByte</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Fill byte used for filling CAN frames to eight byte length.</TUV>
</DESC>
<QUAL>CAN_FD.CANFrameFillerByte</QUAL>
</UNSDEF>
<ENUMDEF id='_0000024830D57260' oid='8EA5EA7D1EE543799D9CA58F6CA2BF25' temploid='B1A795007B6B4bab8D5B9F4E00700E54' attrcatref='_0000024830A55B90' usage='admin' v='1' sort='id'>
<NAME>
<TUV xml:lang='en-US'>FillerByteHandling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enables use of fill bytes; if "true", fill bytes are used, otherwise DLC may be smaller than 8.</TUV>
</DESC>
<QUAL>CAN_FD.FillerByteHandling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>false</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>true</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000024830D57450' oid='9229E6A523DE4e3f9E646328BC6D08A2' temploid='6E678165CBE24be1979D1A4E70A69DB9' attrcatref='_0000024830A55B90' usage='admin' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Functional Addressing Scheme</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Addressing Scheme used for functional requests.</TUV>
</DESC>
<QUAL>CAN_FD.AddrSchemeFunc</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Normal</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000024830D57E00' oid='F398F254510147acA14A7DCCA6F51BE9' temploid='E7C75E5FA51A414292C620CDEF2B4ED7' attrcatref='_0000024830A55B90' usage='admin' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Functional CAN-ID Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>CAN-ID Type used for functional request</TUV>
</DESC>
<QUAL>CAN_FD.CanIdTypeFunc</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>11-Bit</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>29-Bit</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_0000024830D73E70' oid='8F8C1EE448134703A5F01C6970F75902' temploid='BAF6AA71CF1A4cf3AE22A97C0728F2D3' attrcatref='_0000024830A55B90' usage='admin' v='1872' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Functional Request CAN-ID</TUV>
</NAME>
<DESC>

<DESC>
<TUV xml:lang='en-US'>Only exported if Service $2A with transmissionMode $02 (sendAtMediumRate) is supported.</TUV>
</DESC>
<QUAL>Periodic_Rate_Medium_in_ms</QUAL>
</UNSDEF>
<UNSDEF id='_0000024830D3DCA0' oid='CABA6A5D0F8E413d8CE0B5D0A1D91CDC' temploid='FF06A0BADCE348dc983363E67E5D1CB8' attrcatref='_0000024830C65BF0' v='20' df='dec'>

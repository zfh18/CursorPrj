<TUV xml:lang='en-US'>yes</TUV>
</ETAG>
</ENUMDEF>
<CSTRDEF id='_0000024830C4D540' oid='DD30F880B2074366A0A7D0D531EDC7E4' temploid='80FCF04145304d449917EF494607EB79' attrcatref='_0000024830C65B30'>
<NAME>
<TUV xml:lang='en-US'>NvmBlockDescriptor</TUV>
</NAME>
<DESC>

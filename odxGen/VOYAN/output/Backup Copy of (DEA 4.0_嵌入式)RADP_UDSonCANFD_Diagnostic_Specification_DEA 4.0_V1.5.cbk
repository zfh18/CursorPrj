</DESC>
<QUAL>NvmBlockDescriptor</QUAL>
<COMMONSTRING></COMMONSTRING>
</CSTRDEF>
<ENUMDEF id='_0000024830C6C610' oid='A655E8F5CF4F46acB887E35CCBBC0EA5' temploid='9ECCE7FD714B4accBC2CC8FC7A7EADCF' attrcatref='_0000024830A56190' restr='SecurityAccessEmission_related_Trouble_CodesFile_TransferResetIdentificationConfigurationOBD_II_Vehicle_InformationOBD_II_Deeper_Inspection_with_Test_ResultsOBD_II_Controlling_the_SystemOBD_II_Diagnostic_and_Freeze_Frame_DataLink_Control' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Static_Seed</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>This is used to indicate whether or not a static_seed is used or not for non-standard security algorithms.  This value shall always be false if Delay_Timer and Att_Cnt are not supported.</TUV>
</DESC>
<QUAL>Static_Seed</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>False</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>True</TUV>
</ETAG>
</ENUMDEF>
<CSTRDEF id='_0000024830C4DAE0' oid='B75C0C059A3844abA5DBA0CE282AA8EE' temploid='7F608A1246C140468B53AAECBE1786AE' attrcatref='_0000024830C65B30' restr='IOControlRoutine_ControlFile_TransferResetIdentificationConfigurationOBD_II_Vehicle_InformationOBD_II_Deeper_Inspection_with_Test_ResultsOBD_II_Controlling_the_SystemOBD_II_Diagnostic_and_Freeze_Frame_DataLink_Control' listable='1'>
